<Window x:Class="JobSniper.CrmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:JobSniper.Properties"
        Title="{x:Static p:Resources.CrmWindow_Title}" Height="650" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5" FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid>
        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="{x:Static p:Resources.CrmWindow_Tab_Crm}" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="TxtCompanyName" Grid.Row="0" Text="{x:Static p:Resources.CrmWindow_CompanyName}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static p:Resources.CrmWindow_AliasesLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox Name="TxtAliases" Padding="8" FontSize="14" ToolTip="{x:Static p:Resources.CrmWindow_AliasesTooltip}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static p:Resources.CrmWindow_ReputationLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <RadioButton Name="RbNeutral" Content="{x:Static p:Resources.CrmWindow_RepNeutral}" IsChecked="True" Margin="0,0,15,0"/>
                            <RadioButton Name="RbInfo" Content="{x:Static p:Resources.CrmWindow_RepInfo}" Foreground="#3498DB" FontWeight="Bold" Margin="0,0,15,0"/>
                            <RadioButton Name="RbWarning" Content="{x:Static p:Resources.CrmWindow_RepWarning}" Foreground="#F39C12" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static p:Resources.Pot_Label}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <ComboBox Name="CmbPotential" Padding="5" FontSize="14" Width="300" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_0}" Tag="0"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_1}" Tag="1"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_2}" Tag="2"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_3}" Tag="3"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_4}" Tag="4"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="{x:Static p:Resources.CrmWindow_HistoryLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox Name="TxtHistory" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14" Height="150"/>
                        <CheckBox Name="ChkIsBlacklisted" Content="{x:Static p:Resources.CrmWindow_ChkBlocked}" Foreground="#E74C3C" FontWeight="Bold" Margin="0,15,0,0" Cursor="Hand"/>
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Click="BtnCancel_Click" Content="{x:Static p:Resources.CrmWindow_BtnCancel}" Width="100" Padding="10,8" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" Click="BtnSave_Click" Content="{x:Static p:Resources.CrmWindow_BtnSave}" Width="130" Padding="10,8" Background="#2ECC71" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static p:Resources.CrmWindow_Tab_AiCoach}" FontSize="14" FontWeight="SemiBold">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <!-- Levý sloupec pro seznam inzerátů (Master) -->
                        <ColumnDefinition Width="220"/>
                        <!-- Pravý sloupec pro detail AI posudku (Detail) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEZNAM POZIC FIRMY -->
                    <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                        <ListBox Name="LstCompanyJobs" BorderThickness="0" Background="Transparent" 
                     SelectionChanged="LstCompanyJobs_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <!-- PŮVODNÍ: <TextBlock Text="{Binding Title}" ... /> NAHRAZENO ZA STACKPANEL S AI SKÓRE -->
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2C3E50"/>

                                        <!-- 2. Řádek: Datum a AI Skóre vedle sebe -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DateScraped, StringFormat=d}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding Evaluation.MatchScore, StringFormat=' • 🤖 {0} %', FallbackValue=''}" 
                           FontSize="11" 
                           Foreground="#27AE60" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- PLACEHOLDER POKUD NENÍ POSUDEK / NENÍ VÝBĚR -->
                    <Grid Name="GridNoEval" Grid.Column="1" Visibility="Visible" Background="#F8F9FA">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🤖" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Name="TxtNoEvalMsg" Text="Select a job offer to view its AI evaluation." 
                           Foreground="#95A5A6" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- DETAIL POSUDKU (Zobrazí se jen když má vybraný inzerát hodnocení) -->
                    <ScrollViewer Name="ScrollEvalDetails" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <Border Background="#F8F9FA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.RowSpan="3" Margin="0,0,15,0">
                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_MatchScore}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Name="TxtAiScore" Text="0 %" FontSize="22" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,0,10"/>

                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_Overqualified}" FontSize="12" Foreground="#7F8C8D"/>
                                        <ProgressBar Name="PbOver" Minimum="0" Maximum="10" Value="0" Height="10" Foreground="#E74C3C" Margin="0,2,0,10"/>

                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_Underqualified}" FontSize="12" Foreground="#7F8C8D"/>
                                        <ProgressBar Name="PbUnder" Minimum="0" Maximum="10" Value="0" Height="10" Foreground="#F39C12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Static p:Resources.CrmWindow_Ai_HiddenRole}" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBlock Name="TxtAiRole" Grid.Column="1" Grid.Row="1" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Static p:Resources.CrmWindow_Ai_Strategy}" FontSize="12" Foreground="#7F8C8D"/>
                                    <Border Grid.Column="1" Grid.Row="3" Background="#3498DB" CornerRadius="4" Padding="5" HorizontalAlignment="Left" Margin="0,5,0,0">
                                        <TextBlock Name="TxtAiStrategy" Text="-" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- DYNAMICKÉ RED FLAGS -->
                            <StackPanel Name="PanelRedFlags">
                                <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_RedFlags}" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                                <ItemsControl Name="ListAiRedFlags" Margin="0,0,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#C0392B" FontSize="13" Margin="15,2,0,2">
                                                <TextBlock.LayoutTransform>
                                                    <TranslateTransform X="-10"/>
                                                </TextBlock.LayoutTransform>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Height="1" Fill="#E5E7EB" Margin="0,0,0,15"/>
                            </StackPanel>

                            <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_CoachDetail}" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                            <TextBlock Name="TxtAiCoach" TextWrapping="Wrap" FontSize="14" Foreground="#4A5568" LineHeight="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>