<Window x:Class="JobSniper.CrmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:JobSniper.Properties"
        Title="{x:Static p:Resources.CrmWindow_Title}" Height="650" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5" FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid>
        <TabControl Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="{x:Static p:Resources.CrmWindow_Tab_Crm}" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="TxtCompanyName" Grid.Row="0" Text="{x:Static p:Resources.CrmWindow_CompanyName}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static p:Resources.CrmWindow_AliasesLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox Name="TxtAliases" Padding="8" FontSize="14" ToolTip="{x:Static p:Resources.CrmWindow_AliasesTooltip}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static p:Resources.CrmWindow_ReputationLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <RadioButton Name="RbNeutral" Content="{x:Static p:Resources.CrmWindow_RepNeutral}" IsChecked="True" Margin="0,0,15,0"/>
                            <RadioButton Name="RbInfo" Content="{x:Static p:Resources.CrmWindow_RepInfo}" Foreground="#3498DB" FontWeight="Bold" Margin="0,0,15,0"/>
                            <RadioButton Name="RbWarning" Content="{x:Static p:Resources.CrmWindow_RepWarning}" Foreground="#F39C12" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="{x:Static p:Resources.Pot_Label}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <ComboBox Name="CmbPotential" Padding="5" FontSize="14" Width="300" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_0}" Tag="0"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_1}" Tag="1"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_2}" Tag="2"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_3}" Tag="3"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Pot_4}" Tag="4"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="{x:Static p:Resources.CrmWindow_HistoryLabel}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox Name="TxtHistory" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14" Height="150"/>
                        <CheckBox Name="ChkIsBlacklisted" Content="{x:Static p:Resources.CrmWindow_ChkBlocked}" Foreground="#E74C3C" FontWeight="Bold" Margin="0,15,0,0" Cursor="Hand"/>
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Click="BtnCancel_Click" Content="{x:Static p:Resources.CrmWindow_BtnCancel}" Width="100" Padding="10,8" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="2" Click="BtnSave_Click" Content="{x:Static p:Resources.CrmWindow_BtnSave}" Width="130" Padding="10,8" Background="#2ECC71" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 2. ZÁLOŽKA: AI COACH (Inzeráty a posudky) -->
            <TabItem Header="{x:Static p:Resources.CrmWindow_Tab_AiCoach}" FontSize="14" FontWeight="SemiBold">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <!-- Levý sloupec pro seznam inzerátů (Master) -->
                        <ColumnDefinition Width="220"/>
                        <!-- Pravý sloupec pro detail (Detail a posudek) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEVÝ PANEL: SEZNAM POZIC FIRMY -->
                    <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                        <ListBox Name="LstCompanyJobs" BorderThickness="0" Background="Transparent" 
                                 SelectionChanged="LstCompanyJobs_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2C3E50"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DateScraped, StringFormat=d}" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Evaluation.StrategicScore, StringFormat=' • 🎯 {0} %', FallbackValue=''}" 
           FontSize="11" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- PRAVÝ PANEL: DETAIL VYBRANÉ POZICE -->
                    <Grid Grid.Column="1" Background="#F8F9FA" Margin="10,0,0,0">

                        <!-- Zástupce, když není vybrána žádná pozice v seznamu vlevo -->
                        <Grid Name="GridNoSelection" Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🖱️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="{x:Static p:Resources.CrmWindow_SelectJobMsg}" Foreground="#95A5A6" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Detail vybrané pozice (rozdělený na Info a AI Posudek) -->
                        <TabControl Name="TabJobDetails" Visibility="Collapsed" Background="Transparent" BorderThickness="0">

                            <!-- POD-ZÁLOŽKA 1: DETAIL A PÁROVÁNÍ URL -->
                            <TabItem Header="{x:Static p:Resources.CrmWindow_Tab_JobInfo}" FontSize="14" FontWeight="SemiBold">
                                <StackPanel Margin="10">
                                    <TextBlock Name="TxtDetailTitle" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Name="TxtDetailDate" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,20"/>

                                    <TextBlock Text="{x:Static p:Resources.CrmWindow_OriginalUrl}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                                    <TextBox Name="TxtOriginalUrl" IsReadOnly="True" Background="#E5E7EB" Foreground="#7F8C8D" Padding="8" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                    <TextBlock Text="{x:Static p:Resources.CrmWindow_PairingUrl}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="TxtPairingUrl" Grid.Column="0" Padding="8" FontSize="12" Margin="0,0,10,0" ToolTip="Vložte URL z prohlížeče pro manuální spárování."/>
                                        <Button Grid.Column="1" Click="BtnSavePairingUrl_Click" Content="{x:Static p:Resources.CrmWindow_BtnSaveUrl}" Width="100" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="5"/>
                                    </Grid>
                                    <TextBlock Text="{x:Static p:Resources.CrmWindow_PairingUrlHelp}" FontSize="11" Foreground="#95A5A6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>

                            <!-- POD-ZÁLOŽKA 2: AI POSUDEK -->
                            <TabItem Header="{x:Static p:Resources.CrmWindow_Tab_AiEval}" FontSize="14" FontWeight="SemiBold">
                                <Grid>
                                    <!-- Placeholder pokud inzerát nemá posudek -->
                                    <Grid Name="GridNoEval" Visibility="Visible" Background="#F8F9FA">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🤖" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Name="TxtNoEvalMsg" Text="No AI evaluation generated for this role yet." 
                                                       Foreground="#95A5A6" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Vlastní posudek (původní struktura) -->
                                    <ScrollViewer Name="ScrollEvalDetails" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="20">
                                            <Border Background="#F8F9FA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Column="0" Grid.RowSpan="4" Margin="0,0,15,0">
                                                        <TextBlock Text="Raw HR Skóre" FontSize="11" Foreground="#7F8C8D" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Name="TxtRawScore" Text="0 %" FontSize="18" FontWeight="SemiBold" Foreground="#E74C3C" Margin="0,0,0,10"/>

                                                        <TextBlock Text="Strategické Skóre" FontSize="11" Foreground="#7F8C8D" FontWeight="Bold"/>
                                                        <TextBlock Name="TxtStrategicScore" Text="0 %" FontSize="24" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,0,15"/>

                                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_Overqualified}" FontSize="11" Foreground="#7F8C8D"/>
                                                        <ProgressBar Name="PbOver" Minimum="0" Maximum="10" Value="0" Height="8" Foreground="#E74C3C" Margin="0,2,0,10"/>

                                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_Underqualified}" FontSize="11" Foreground="#7F8C8D"/>
                                                        <ProgressBar Name="PbUnder" Minimum="0" Maximum="10" Value="0" Height="8" Foreground="#F39C12" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Grid.RowSpan="4">

                                                        <Border Name="BorderGoNoGo" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Name="TxtGoNoGo" Text="N/A" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                        </Border>

                                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_HiddenRole}" FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Name="TxtAiRole" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                        <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_Strategy}" FontSize="11" Foreground="#7F8C8D"/>
                                                        <Border Background="#3498DB" CornerRadius="4" Padding="5" HorizontalAlignment="Left" Margin="0,2,0,5">
                                                            <TextBlock Name="TxtAiStrategy" Text="-" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                        </Border>

                                                        <TextBlock Text="Důvod strategie:" FontSize="11" Foreground="#7F8C8D" Margin="0,5,0,2"/>
                                                        <TextBlock Name="TxtStrategyReasoning" Text="-" FontSize="12" Foreground="#34495E" TextWrapping="Wrap" FontStyle="Italic"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- DYNAMICKÉ RED FLAGS -->
                                            <StackPanel Name="PanelRedFlags">
                                                <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_RedFlags}" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                                                <ItemsControl Name="ListAiRedFlags" Margin="0,0,0,15">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#C0392B" FontSize="13" Margin="15,2,0,2">
                                                                <TextBlock.LayoutTransform>
                                                                    <TranslateTransform X="-10"/>
                                                                </TextBlock.LayoutTransform>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Rectangle Height="1" Fill="#E5E7EB" Margin="0,0,0,15"/>
                                            </StackPanel>

                                            <TextBlock Text="{x:Static p:Resources.CrmWindow_Ai_CoachDetail}" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                                            <TextBlock Name="TxtAiCoach" TextWrapping="Wrap" FontSize="14" Foreground="#4A5568" LineHeight="20" Margin="0,0,0,20"/>

                                            <Expander Header="Source Job Description (Debug View)" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,20">
                                                <TextBox Name="TxtEvaluatedJobDescription" IsReadOnly="True" Background="#E5E7EB" Foreground="#2C3E50" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="250" Padding="10" Margin="0,5,0,0" FontFamily="Consolas" FontSize="12"/>
                                            </Expander>

                                            <Button Click="BtnDeleteEvaluation_Click" Content="🗑️ Delete this evaluation" HorizontalAlignment="Right" Background="#E74C3C" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>