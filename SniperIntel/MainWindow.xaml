<Window x:Class="SniperIntel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SniperIntel - Job Market Dossier" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Vyhledávání -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333337" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SNIPER INTEL" Foreground="#27AE60" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Grid.Column="0"/>
                
                <TextBox x:Name="TxtSearch" Grid.Column="1" Height="30" Margin="20,0" VerticalContentAlignment="Center" 
                         Background="#333337" Foreground="#E0E0E0" BorderThickness="0" Padding="10,0"
                         TextChanged="TxtSearch_TextChanged" />
                
                <!-- Placeholder pro Textbox -->
                <TextBlock IsHitTestVisible="False" Text="Hledat firmu..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" Foreground="#888888" Grid.Column="1">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="#888" Text="Dossiers: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalCompanies" Foreground="#E0E0E0" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEVÝ PANEL: Seznam firem (Master) -->
            <Border Grid.Column="0" BorderBrush="#333337" BorderThickness="0,0,1,0">
                <ListView x:Name="LstCompanies" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0"
                          SelectionChanged="LstCompanies_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding PrimaryName}" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="Reputace: " Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding Reputation}" Foreground="#27AE60" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text=" | Aktualizováno: " Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding LastInteraction, StringFormat=dd.MM.yyyy}" Foreground="#888888" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#333337"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D2D30"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Border>

            <!-- PRAVÝ PANEL: Detail firmy (The Intel) -->
            <Grid Grid.Column="1" Background="#1E1E1E">
                <Grid x:Name="GridIntelDetail" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <!-- Hlavička detailu -->
                    <Border Grid.Row="0" Background="#252526" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="TxtDetailName" Text="Název Firmy" FontSize="28" FontWeight="Bold" Foreground="#E0E0E0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Reputace: " Foreground="#888" FontSize="14"/>
                                <TextBlock x:Name="TxtDetailReputation" Text="0" Foreground="#27AE60" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text=" | Aliasy: " Foreground="#888" FontSize="14" Margin="15,0,0,0"/>
                                <TextBlock x:Name="TxtDetailAliases" Foreground="#888" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Záznam CRM (Know-how) -->
                    <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CRM ZÁZNAM (INTEL)" Foreground="#27AE60" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                            <TextBox x:Name="TxtInteractionHistory" IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                     Foreground="#E0E0E0" TextWrapping="Wrap" FontSize="14" AcceptsReturn="True"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#333337" Height="1" Margin="20,0"/>

                    <!-- Seznam Inzerátů jako důkazy -->
                    <Grid Grid.Row="3" Margin="20,10,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="POSLEDNÍ ZAZNAMENANÉ INZERÁTY" Foreground="#27AE60" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DgCompanyJobs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Background="Transparent" RowBackground="#252526" AlternatingRowBackground="#1E1E1E" 
                                  Foreground="#E0E0E0" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pozice" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Plat" Binding="{Binding Salary}" Width="150"/>
                                <DataGridTextColumn Header="Lokalita" Binding="{Binding Location}" Width="150"/>
                                <DataGridTextColumn Header="Zdroj" Binding="{Binding PortalName}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
                
                <!-- Úvodní obrazovka, když není nic vybráno -->
                <StackPanel x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="60" HorizontalAlignment="Center" Foreground="#333337"/>
                    <TextBlock Text="Vyber firmu vlevo a zobraz Intel" Foreground="#888888" FontSize="16" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>